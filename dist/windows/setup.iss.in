#define AppVersion "@VERSION@"
[Setup]
AppId=PapoTUI-@ARCH@
AppName=Papo TUI
AppVersion={#AppVersion}
AppPublisher=Papo TUI contributors
DefaultDirName={localappdata}\Programs\Papo TUI
DefaultGroupName=Papo TUI
PrivilegesRequired=lowest
ArchitecturesAllowed=@ARCH_ALLOWED@
ArchitecturesInstallIn64BitMode=@ARCH_ALLOWED@
MinVersion=10.0.22000
OutputDir=@OUTPUT@
OutputBaseFilename=papo-tui-@VERSION@-windows-@ARCH@-setup
Compression=lzma2
SolidCompression=yes
UninstallDisplayIcon={app}\papo-tui.exe
LicenseFile=@SOURCE@\share\licenses\papo-tui\LICENSE
[Files]
Source: "@SOURCE@\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
[Icons]
Name: "{group}\Papo TUI"; Filename: "{app}\papo-tui.exe"; WorkingDir: "{app}"
[Run]
Filename: "{app}\papo-tui.exe"; Description: "Abrir Papo TUI"; Flags: postinstall nowait skipifsilent unchecked
