--- a/ncurses/curses.priv.h
+++ b/ncurses/curses.priv.h
@@ -2294,0 +2295,2 @@
+/* Keep UCRT declarations ahead of the conversion macros. */
+#include <wchar.h>
@@ -2732,0 +2735,3 @@
+/* Distinguish native UTF-16 input units from ncurses key codes until the
+ * public narrow/wide input wrapper selects the character representation. */
+#define NCURSES_WIN32_WIDE 0x10000000
--- a/ncurses/tinfo/lib_win32con.c
+++ b/ncurses/tinfo/lib_win32con.c
@@ -89,0 +90,4 @@
+/* ReadConsoleInput coalesces adjacent equal keys in wRepeatCount. */
+static HANDLE repeated_handle;
+static int repeated_key;
+static WORD repeated_count;
@@ -636,16 +640,4 @@
-    if (mask & RIGHTMOST_BUTTON_PRESSED) {
-	switch (WINCONSOLE.numButtons) {
-	case 1:
-	    result |= BUTTON1_PRESSED;
-	    break;
-	case 2:
-	    result |= BUTTON2_PRESSED;
-	    break;
-	case 3:
-	    result |= BUTTON3_PRESSED;
-	    break;
-	case 4:
-	    result |= BUTTON4_PRESSED;
-	    break;
-	}
-    }
+    /* Console hosts may report one/two physical buttons or no mouse at all.
+     * Keep the terminal convention: right click is always button three. */
+    if (mask & RIGHTMOST_BUTTON_PRESSED)
+        result |= BUTTON3_PRESSED;
@@ -832,0 +825,6 @@
+
+    if ((mode & TW_INPUT) && hdl == repeated_handle && repeated_count) {
+        if (timeleft)
+            *timeleft = milliseconds;
+        return TW_INPUT;
+    }
@@ -1022,0 +1021,6 @@
+    if (hdl == repeated_handle && repeated_count) {
+        --repeated_count;
+        *buf = repeated_key;
+        return 1;
+    }
+
@@ -1068,0 +1073,8 @@
+#if USE_WIDEC_SUPPORT
+		if (inp_rec.Event.KeyEventChar >= 128)
+		    *buf = (int) inp_rec.Event.KeyEventChar | NCURSES_WIN32_WIDE;
+#endif
+		repeated_handle = hdl;
+		repeated_key = *buf;
+		repeated_count = inp_rec.Event.KeyEvent.wRepeatCount > 1
+		    ? (WORD) (inp_rec.Event.KeyEvent.wRepeatCount - 1) : 0;
--- a/ncurses/widechar/lib_get_wch.c
+++ b/ncurses/widechar/lib_get_wch.c
@@ -75,0 +76,7 @@
+#ifdef _NC_WINDOWS
+	    } else if (value & NCURSES_WIN32_WIDE) {
+		/* Console input is UTF-16, not a byte of a UTF-8 sequence. */
+		value &= ~NCURSES_WIN32_WIDE;
+		code = OK;
+		break;
+#endif
