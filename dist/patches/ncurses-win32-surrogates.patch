+/* A 16-bit wchar_t holds characters outside the BMP as surrogate pairs,
+ * which _nc_wctomb cannot convert one half at a time. Emit the pair as one
+ * UTF-8 sequence and step over its low half. */
+static NCURSES_INLINE int
+_nc_putc_wcrtomb(char *buffer, const wchar_t *chars, int *index)
+{
+    unsigned long high = (unsigned long) chars[*index];
+    unsigned long low = *index + 1 < CCHARW_MAX ? (unsigned long) chars[*index + 1] : 0;
+    if (high >= 0xD800 && high <= 0xDBFF && low >= 0xDC00 && low <= 0xDFFF) {
+	unsigned long value = 0x10000 + ((high - 0xD800) << 10) + (low - 0xDC00);
+	buffer[0] = (char) (0xF0 | (value >> 18));
+	buffer[1] = (char) (0x80 | ((value >> 12) & 0x3F));
+	buffer[2] = (char) (0x80 | ((value >> 6) & 0x3F));
+	buffer[3] = (char) (0x80 | (value & 0x3F));
+	++*index;
+	return 4;
+    }
+    return _nc_wctomb(buffer, chars[*index]);
+}
+#define PUTC_WCRTOMB(buffer, chars, index, state) \
+	_nc_putc_wcrtomb(buffer, chars, &(index))
+
 #endif /* _NC_WINDOWS_NATIVE && !_NC_MSC */
 
