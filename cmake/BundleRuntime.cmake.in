if(WIN32)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
else()
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM linux+elf)
endif()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_OBJDUMP@")
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "$<TARGET_FILE:papo-tui>"
    MODULES "$<TARGET_FILE:papo_image_codec>" "$<TARGET_FILE:papo_video_player>"
    DIRECTORIES @PAPO_RUNTIME_SEARCH_DIRS@
    RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR unresolved
    PRE_EXCLUDE_REGEXES "^lib(c|m|dl|pthread|rt|resolv)\\.so" "^ld-linux" "^[Aa][Pp][Ii]-[Mm][Ss]-" "^[Ee][Xx][Tt]-[Mm][Ss]-"
    POST_EXCLUDE_REGEXES ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\].*" "/lib[^/]*/ld-linux.*" "/lib[^/]*/lib(c|m|dl|pthread|rt|resolv)\\.so.*")
if(unresolved)
    message(FATAL_ERROR "Unresolved runtime dependencies: ${unresolved}")
endif()
if(WIN32)
    set(destination "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@")
else()
    set(destination "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_LIBDIR@/papo-tui")
endif()
foreach(library IN LISTS resolved)
    file(INSTALL "${library}" DESTINATION "${destination}" FOLLOW_SYMLINK_CHAIN)
endforeach()

if(NOT WIN32)
    find_program(PATCHELF patchelf REQUIRED)
    file(GLOB libraries "${destination}/*")
    foreach(library IN LISTS libraries)
        if(NOT IS_SYMLINK "${library}")
            execute_process(COMMAND "${PATCHELF}" --set-rpath "$ORIGIN" "${library}" COMMAND_ERROR_IS_FATAL ANY)
        endif()
    endforeach()
endif()
set(manifest "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_DATADIR@/doc/papo-tui/runtime-libraries.json")
get_filename_component(manifest_dir "${manifest}" DIRECTORY)
file(MAKE_DIRECTORY "${manifest_dir}")
file(WRITE "${manifest}" "[\n")
set(separator "")
foreach(library IN LISTS resolved)
    file(SHA256 "${library}" digest)
    string(REPLACE "\\" "/" source_path "${library}")
    string(REPLACE "\"" "\\\"" source_path "${source_path}")
    file(APPEND "${manifest}" "${separator}{\"source\":\"${source_path}\",\"sha256\":\"${digest}\"}")
    set(separator ",\n")
endforeach()
file(APPEND "${manifest}" "\n]\n")
